[Unit]
Description=Crab Shop API (Fastify + SQLite)
After=network.target

[Service]
Type=simple
User=crabshop
WorkingDirectory=/opt/crabshop/server
Environment=NODE_ENV=production
Environment=PORT=7649
Environment=DATABASE_PATH=/opt/crabshop/data/app.db
EnvironmentFile=/opt/crabshop/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
